% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (ScipyOptimizeDriver);
\chainin (mat) [join=by ProcessHV];
\chainin (gear) [join=by ProcessHV];
\chainin (layout) [join=by ProcessHV];
\chainin (bear1) [join=by ProcessHV];
\chainin (bear2) [join=by ProcessHV];
\chainin (brake) [join=by ProcessHV];
\chainin (elec) [join=by ProcessHV];
\chainin (yaw) [join=by ProcessHV];
\chainin (rpm) [join=by ProcessHV];
\chainin (gensimp) [join=by ProcessHV];
\chainin (lss) [join=by ProcessHV];
\chainin (mb@fls) [join=by ProcessHV];
\chainin (hss) [join=by ProcessHV];
\chainin (misc) [join=by ProcessHV];
\chainin (nac) [join=by ProcessHV];
\chainin (rna) [join=by ProcessHV];
\chainin (bed) [join=by ProcessHV];
\chainin (ScipyOptimizeDriver) [join=by ProcessHV];
\end{pgfonlayer}
}

